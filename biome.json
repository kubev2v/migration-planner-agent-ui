{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.tmp",
      "!**/.cache",
      "!**/out",
      "!packages/api-client"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "javascript": {
    "globals": ["console", "process", "Buffer", "__dirname", "__filename"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/ioc/**", "packages/shared-components/**"],
      "linter": { "domains": { "react": "recommended" } }
    }
  ]
}
