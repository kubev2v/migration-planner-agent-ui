{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for migration-planner-agent-ui",
  "extends": ["github>kubev2v/migration-planner-workflows//renovate-config/default.json"],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Use bump strategy for npm dependencies",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group npm minor and patch updates into a single PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch dependencies",
      "automerge": true
    },
    {
      "description": "Disable major updates to avoid breaking changes",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Ignore @openshift-migration-advisor packages; versions are pinned manually in package.json",
      "matchPackageNames": ["@openshift-migration-advisor/**"],
      "enabled": false
    },
    {
      "description": "Use chore commit type for all npm updates",
      "matchManagers": ["npm"],
      "semanticCommitType": "chore"
    },
    {
      "description": "Automerge build-tools submodule updates",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["build-tools"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "platformAutomerge": true
  }
}
